# Copy this file to .env (gitignored) and fill in ONE key to use a real language model.
# Without any key the app runs on its built-in rule-based backend; every feature still works.

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=

# OpenRouter, which has free models (https://openrouter.ai)
OPENROUTER_API_KEY=

# Optional: force a backend (anthropic | gemini | openrouter | offline). Default: whichever key is set.
ANALYST_LLM_PROVIDER=

# Optional: hard cap on OpenRouter calls per server run (protects a free quota)
# OPENROUTER_MAX_CALLS=50
